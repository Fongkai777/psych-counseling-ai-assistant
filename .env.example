# DashScope / OpenAI-compatible chat completion API for answer generation,
# rewriting, document cleaning, and review.
# Leave keys empty to use local demo mode.
DASHSCOPE_API_KEY=
LLM_API_KEY=
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-max
LLM_ENABLE_THINKING=true

# OpenAI-compatible embeddings API for semantic RAG.
# If empty, the app falls back to local lexical retrieval.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_MAX_INPUT_CHARS=8000
EMBEDDING_BATCH_SIZE=5

# Optional DashScope reranker.
RERANK_ENABLED=true
RERANK_MODEL=qwen3-vl-rerank

LLM_TEMPERATURE=0.7
APP_HOST=127.0.0.1
APP_PORT=8000
