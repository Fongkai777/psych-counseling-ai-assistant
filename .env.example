# OpenAI-compatible chat completion API for answer generation, rewriting,
# document cleaning, and review.
# Leave LLM_API_KEY empty to use local demo mode.
LLM_API_KEY=
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.4-mini

# For Alibaba DashScope native models such as qwen3.8-max:
# LLM_PROVIDER=dashscope_native
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen3.8-max

# OpenAI-compatible embeddings API for semantic RAG.
# If empty, the app falls back to local lexical retrieval.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

LLM_TEMPERATURE=0.7
APP_HOST=127.0.0.1
APP_PORT=8000
